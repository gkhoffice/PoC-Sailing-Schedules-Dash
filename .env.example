# Public HTTP port exposed by the web container.
WEB_PORT=8080

# API port on the private Docker network; it is not published to the host.
API_PORT=8080

# Nginx's API upstream. Keep "api" for the included Compose service.
API_HOST=api

# API log verbosity: fatal, error, warn, info, debug, or trace.
LOG_LEVEL=info

# Optional path to a Chromium executable. Leave blank to use the browser
# installed in the matching Playwright container image.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=